Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Rejilla 1 m
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
    - Class: rviz_default_plugins/Map
      Name: Mapa
      Enabled: true
      Topic: {Value: /map, Depth: 1, Durability Policy: Transient Local, Reliability Policy: Reliable, History Policy: Keep Last}
  Global Options: {Fixed Frame: map, Background Color: 48; 48; 48}
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current: {Class: rviz_default_plugins/TopDownOrtho, Name: Cenital, X: 7.8, Y: 7.0, Scale: 50, Angle: 0}
Window Geometry:
  Displays: {collapsed: false}
  Width: 1280
  Height: 900
  X: 0
  Y: 0
